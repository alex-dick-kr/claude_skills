    "parameters": {
      "location_type": {
        "in": "query",
        "name": "location_type",
        "description": "Used to select type of location to pull data for.",
        "required": false,
        "schema": {
          "type": "string",
          "enum": [
            "all",
            "store",
            "distcenter",
            "mfg",
            "office",
            "vendor",
            "datacenter",
            "jewelry"
          ]
        }
      },
      "value": {
        "in": "query",
        "name": "value",
        "description": "Used to select location status or a specific location for response data.",
        "required": true,
        "schema": {
          "type": "string"
        },
        "examples": {
          "all": {
            "summary": "All location types",
            "value": "all"
          },
          "active": {
            "summary": "Active location types",
            "value": "active"
          },
          "8 digit facility code": {
            "summary": "Example facility code in the 000XX000 format",
            "value": 6000905
          },
          "5 digit store zone and id (short name)": {
            "summary": "Example short name facility code format XX000",
            "value": "go905"
          }
        }
      },
      "status": {
        "in": "query",
        "name": "status",
        "description": "Used to select location status for response data.",
        "required": false,
        "schema": {
          "type": "string",
          "enum": [
            "all",
            "open",
            "active",
            "closed",
            "inactive"
          ]
        }
      },
      "facility_code": {
        "in": "query",
        "name": "facility_code",
        "description": "Location facility code in the 8 digit format or short name format.",
        "required": true,
        "schema": {
          "type": "string"
        },
        "examples": {
          "8 digit format": {
            "value": "06000905",
            "summary": "Example facility code in the 000XX000 format"
          },
          "short name format": {
            "value": "go905",
            "summary": "Example short name facility code format XX000"
          }
        }
      },
      "ip_address": {
        "in": "query",
        "name": "ip_address",
        "description": "IP Address or IP subnet",
        "required": true,
        "schema": {
          "type": "string"
        },
        "example": "192.168.100.1"
      },
      "cidr": {
        "in": "query",
        "name": "cidr",
        "description": "Cidr Mask for an IP subnet",
        "schema": {
          "type": "integer"
        },
        "example": 24
      },
      "guid": {
        "in": "query",
        "name": "guid",
        "description": "GUID for MS Teams",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "asset_name": {
        "in": "query",
        "name": "asset_name",
        "description": "Name of the requested Asset",
        "required": true,
        "schema": {
          "type": "string"
        },
        "example": "go905osna1u"
      },
      "type": {
        "in": "query",
        "name": "type",
        "description": "Circuit Type for the circuit asset",
        "required": true,
        "schema": {
          "type": "string",
          "enum": [
            "all",
            "broadband",
            "t1",
            "ethernet",
            "cellular",
            "ds3",
            "evpl",
            "dia",
            "pots",
            "inseego"
          ]
        }
      },
      "latitude": {
        "in": "query",
        "name": "latitude",
        "description": "Latitude value. -<latitude> format allow but not +<latitude> format.",
        "required": true,
        "schema": {
          "type": "string"
        },
        "examples": {
          "positive": {
            "value": 175,
            "summary": "A positive latitude value without the leading +."
          },
          "negative": {
            "value": "-180",
            "summary": "A negative latitude value with the leading -."
          }
        }
      },
      "longitude": {
        "in": "query",
        "name": "longitude",
        "description": "Longitude value. -<longitude> format allow but not +<longitude> format.",
        "required": true,
        "schema": {
          "type": "string"
        },
        "examples": {
          "positive": {
            "value": 175,
            "summary": "A positive longitude value without the leading +."
          },
          "negative": {
            "value": "-180",
            "summary": "A negative longitude value with the leading -."
          }
        }
      },
      "field": {
        "in": "query",
        "name": "field",
        "description": "Field to report is incorrect",
        "required": true,
        "schema": {
          "type": "string",
          "enum": [
            "address",
            "other"
          ]
        }
      },
      "flag": {
        "in": "query",
        "name": "flag",
        "description": "Flag used to notify whether a field configured in Sherpa is missing or incorrect.",
        "required": true,
        "schema": {
          "type": "string",
          "enum": [
            "mismatch",
            "missing"
          ]
        }
      },
      "description": {
        "in": "query",
        "name": "description",
        "description": "Description for the notification to developers that a field needs addressed.",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    }
