        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://api.kroger.com",
            "scopes": {
              "urn:com:kroger:kr:sherpa:assets:read": "Provides read access to asset data.",
              "urn:com:kroger:kr:sherpa:locations:read": "Provides read access to location data.",
              "urn:com:kroger:kr:sherpa:assets:readwrite": "Provides read/write access to asset data.",
              "urn:com:kroger:kr:sherpa:locations:readwrite": "Provides read/write access to location data."
            }
          }
        }
      }
